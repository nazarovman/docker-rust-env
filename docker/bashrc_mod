export EDITOR="hx"
export PATH="/usr/local/rustup/toolchains/1.98.1-x86_64-unknown-linux-gnu/bin:$PATH"

if [ -n "$SSH_CLIENT" ] || [ -n "$SSH_TTY" ]; then
    if [ -z "$ZELLIJ" ]; then
        cd /workspace 2>/dev/null || cd "$HOME"
        /usr/local/bin/zellij --layout /usr/local/share/zellij/layouts/workspace.kdl attach -c main
        exit
    fi
fi
