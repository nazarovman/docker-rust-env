layout {
    default_tab_template {
        pane size=1 borderless=true {
            plugin location="zellij:tab-bar"
        }
        children
        pane size=1 borderless=true {
            plugin location="zellij:status-bar"
        }
    }

    tab name="Workspace" {
        pane split_direction="horizontal" name="Editor" focus=true {
            command "hx"
			args "."
            start_suspended false
        }
        pane name="Console" size="20%" {
            command "/bin/bash"
            start_suspended false
        }
    }
}
